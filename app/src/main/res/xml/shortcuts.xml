            android:action="com.nebula.browser.action.NEW_TAB"
            android:targetPackage="com.nebula.browser"
            android:targetClass="com.nebula.browser.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
